# ========================================================
# Konfiguration für das historische Bildarchiv-Suchsystem
# ========================================================

# Qdrant Vektordatenbank
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=false
QDRANT_API_KEY=

# Collection Namen
COLLECTION_IMAGES=archive_images
COLLECTION_FACES=archive_faces

# Hardware / Beschleunigung ('cuda' oder 'cpu')
DEVICE=cpu

# OpenCLIP Konfiguration (512-dim Embeddings für ViT-B-32)
CLIP_MODEL_NAME=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# Biometrische Gesichtserkennung (Art. 9 DSGVO)
# Standard: false (Datensparsamkeit). Setzen Sie auf true, um InsightFace & ArcFace zu aktivieren.
ENABLE_FACE_RECOGNITION=false

# InsightFace Konfiguration (nur aktiv bei ENABLE_FACE_RECOGNITION=true)
INSIGHTFACE_MODEL_NAME=buffalo_l
INSIGHTFACE_DET_SIZE=640

# Archivdaten & Verzeichnisschutz
ARCHIVE_DATA_DIR=./data
ALLOWED_IMAGE_DIRS=["./data", "."]
THUMBNAIL_CACHE_DIR=./.cache/thumbnails

# Sicherheit & CORS
CORS_ORIGINS=["http://localhost:8000", "http://127.0.0.1:8000"]
